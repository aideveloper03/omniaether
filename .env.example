# AETHER-MINE Environment Configuration

# Application Settings
AETHER_ENVIRONMENT=development
AETHER_DEBUG=false
AETHER_LOG_LEVEL=INFO

# Data Paths
AETHER_DATA_DIR=data
AETHER_PARQUET_DIR=data/parquet
AETHER_QUARANTINE_DIR=data/quarantine
AETHER_INDEX_DIR=data/index

# Batch Settings
AETHER_BATCH_MAX_RECORDS=1000
AETHER_BATCH_MAX_SIZE_MB=50
AETHER_BATCH_FLUSH_INTERVAL_SECONDS=60

# Redis Settings
AETHER_REDIS_HOST=localhost
AETHER_REDIS_PORT=6379
AETHER_REDIS_DB=0
# AETHER_REDIS_PASSWORD=

# Celery Settings
AETHER_CELERY_BROKER_URL=redis://localhost:6379/0
AETHER_CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Proxy Settings
AETHER_PROXY_POOL_SIZE=10
AETHER_PROXY_ROTATION_THRESHOLD=50
AETHER_PROXY_BURN_TIMEOUT_HOURS=24
AETHER_PROXY_MAX_FAILURES=3

# Browser Settings
AETHER_BROWSER_HEADLESS=true
AETHER_BROWSER_TIMEOUT_MS=30000
AETHER_FINGERPRINT_ROTATION_REQUESTS=50

# Rate Limiting
AETHER_RATE_LIMIT_REQUESTS_PER_MINUTE=60
AETHER_RATE_LIMIT_BURST=10

# Stealth Settings
AETHER_HUMAN_DELAY_MIN_MS=500
AETHER_HUMAN_DELAY_MAX_MS=3000
AETHER_BEHAVIORAL_NOISE_ENABLED=true

# Cloud Provider Settings (optional)
# AETHER_AWS_ACCESS_KEY_ID=
# AETHER_AWS_SECRET_ACCESS_KEY=
# AETHER_AWS_REGION=us-east-1
# AETHER_AZURE_CONNECTION_STRING=
# AETHER_GCP_CREDENTIALS_PATH=

# LLM Settings
AETHER_LLM_PROVIDER=ollama
AETHER_OLLAMA_BASE_URL=http://localhost:11434
AETHER_OLLAMA_MODEL=llama3.2

# Or for OpenAI
# AETHER_LLM_PROVIDER=openai
# AETHER_OPENAI_API_KEY=sk-your-key-here

# Vector Database
AETHER_VECTOR_DB_PATH=data/chromadb
AETHER_EMBEDDING_MODEL=all-MiniLM-L6-v2

# DuckDB Settings
AETHER_DUCKDB_PATH=data/index/metadata.duckdb
AETHER_DUCKDB_MEMORY_LIMIT=4GB
